{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graph",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "overview": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": [
        "object",
        "array"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "entry",
              "method",
              "branch",
              "return",
              "failure",
              "async",
              "join",
              "external",
              "data"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "service_id": {
            "type": "string",
            "minLength": 1
          },
          "endpoint_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "callsite_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "evidence_refs"
        ]
      },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "call",
              "rpc",
              "control",
              "return",
              "exception",
              "async_start",
              "async_join",
              "data",
              "loop"
            ]
          },
          "condition_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resolution": {
            "enum": [
              "confirmed"
            ]
          },
          "binding_id": {
            "type": "string",
            "minLength": 1
          },
          "mapping_ref": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "kind",
          "condition_refs",
          "evidence_refs"
        ]
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "expression",
          "evidence_refs"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "symbol": {
                "type": "string"
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": []
          }
        },
        "required": [
          "id",
          "path",
          "sha256"
        ]
      },
      "minItems": 1
    },
    "coverage": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "partial",
            "complete"
          ]
        },
        "open_questions": {
          "type": "array",
          "items": {}
        },
        "frontier": {
          "type": "array",
          "items": {}
        },
        "accepted_exclusions": {
          "type": "array",
          "items": {}
        },
        "review": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "passed",
                "failed"
              ]
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": []
        }
      },
      "required": [
        "status",
        "open_questions",
        "frontier",
        "accepted_exclusions"
      ]
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "title",
    "overview",
    "entry",
    "nodes",
    "edges",
    "conditions",
    "evidence",
    "coverage"
  ],
  "additionalProperties": false
}
