{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "overrides",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "add_endpoint",
              "add_binding",
              "replace_targets",
              "disable_binding"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "binding_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_source_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "endpoint_id": {
                  "type": "string",
                  "minLength": 1
                },
                "condition_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "endpoint_id",
                "condition_ref"
              ]
            }
          },
          "endpoint": {
            "type": "object"
          },
          "binding": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "action",
          "reason",
          "evidence_refs"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "symbol": {
                "type": "string"
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": []
          }
        },
        "required": [
          "id",
          "path",
          "sha256"
        ]
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "expression",
          "evidence_refs"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "overrides",
    "evidence"
  ]
}
