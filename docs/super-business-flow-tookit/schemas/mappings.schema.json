{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mappings",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "framework": {
            "type": "object"
          },
          "caller": {
            "type": "object"
          },
          "remote_identity": {
            "type": "object"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "resolution": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "candidate",
                  "confirmed",
                  "disabled"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "id",
          "caller",
          "remote_identity",
          "targets",
          "resolution",
          "source_fingerprint",
          "framework"
        ]
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "symbol": {
                "type": "string"
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": []
          }
        },
        "required": [
          "id",
          "path",
          "sha256"
        ]
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "expression",
          "evidence_refs"
        ]
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {}
    },
    "applied_overrides": {
      "type": "array",
      "items": {}
    }
  },
  "required": [
    "schema_version",
    "bindings",
    "endpoints",
    "evidence"
  ]
}
