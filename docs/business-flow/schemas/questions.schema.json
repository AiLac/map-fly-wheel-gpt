{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "questions",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "answered"
            ]
          },
          "affected_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "options": {
            "type": "array",
            "items": {}
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "answer": {}
        },
        "required": [
          "id",
          "question",
          "status"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "questions"
  ]
}
