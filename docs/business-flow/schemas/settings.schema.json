{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "settings",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "execution": {
      "type": "object",
      "properties": {
        "max_parallel_tasks": {
          "type": "integer",
          "minimum": 1
        },
        "phase_limits": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        },
        "task_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_parallel_tasks"
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "max_memory_items": {
          "type": "integer",
          "minimum": 1
        },
        "max_task_tokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": []
    },
    "memory": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "auto_record": {
          "type": "boolean"
        },
        "retrieve_on_demand": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "output": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "const": "markdown"
        },
        "max_diagram_nodes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": []
    }
  },
  "required": [
    "schema_version",
    "execution"
  ],
  "additionalProperties": false
}
