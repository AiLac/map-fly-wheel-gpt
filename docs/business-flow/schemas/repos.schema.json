{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "repos",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_roots": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "classpath_file": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "source_roots"
              ]
            },
            "minItems": 1
          },
          "code_url_template": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path",
          "modules"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "repos"
  ],
  "additionalProperties": false
}
